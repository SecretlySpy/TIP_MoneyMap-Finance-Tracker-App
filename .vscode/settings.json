{
  "react-native.packager.port": 8081,
  "react-native.packager.status-indicator": "Full",
  "react-native.android.logCatArguments": [
    "*:S",
    "ReactNative:V",
    "ReactNativeJS:V",
    "Expo:V"
  ],
  "react-native-tools.projectRoot": "${workspaceFolder}",
  "files.watcherExclude": {
    "**/.expo/**": true,
    "**/android/.gradle/**": true,
    "**/android/app/build/**": true
  },
  "kimi.yoloMode": true,
  "kimi.showThinkingExpanded": true,
  "chat.checkpoints.showFileChanges": true,
  "discord.detailsDebugging": "Debugging {file_name}",
  "discord.detailsEditing": "Editing {file_name}",
  "discord.detailsIdling": "Idling in {workspace}"
}
