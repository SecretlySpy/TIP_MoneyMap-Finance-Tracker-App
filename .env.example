# PUBLIC Cloud Run HTTPS endpoint only. NEVER put the Gemini API key in Expo / Android.
# Requires Firebase App Check verified on the server and a native token provider in the app.
EXPO_PUBLIC_MONEYMAP_AI_URL=

# Development ONLY: Optional custom debug token for Android emulator testing with Firebase App Check.
# Note: In development builds, the Firebase SDK automatically generates and logs a debug token to Logcat
# (`adb logcat -s FirebaseAppCheck`). Setting a custom token here is optional for headless automation.
# NEVER commit real tokens, and NEVER include debug tokens in production builds. Release builds
# strictly enforce Play Integrity and will ignore this variable.
EXPO_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=

